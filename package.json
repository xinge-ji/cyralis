{
  "name": "cyralis",
  "version": "0.0.0",
  "description": "Host-neutral context and memory layer for coding agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cyralis": "./bin/cyralis.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "default": "./dist/memory/index.js"
    },
    "./host-bindings": {
      "types": "./dist/host-bindings/index.d.ts",
      "import": "./dist/host-bindings/index.js",
      "default": "./dist/host-bindings/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc && node scripts/copy-template-assets.js",
    "prepare": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "agent",
    "context",
    "memory",
    "codex",
    "pi"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2"
  }
}
